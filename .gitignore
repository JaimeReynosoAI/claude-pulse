# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyc

# Virtual environments
venv/
.venv/
env/

# ClaudePulse's own on-disk cache (usage numbers only, but keep it out of git regardless)
*.cache/
usage.json

# Editors / OS
.vscode/
*.swp
.DS_Store

# Never allow anything named like a credential/secret to be committed
*credentials*
*.token
*secret*
